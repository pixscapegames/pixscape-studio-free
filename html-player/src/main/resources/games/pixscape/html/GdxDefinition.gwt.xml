<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Google Inc.//DTD Google Web Toolkit 2.8.2//EN"
        "http://www.gwtproject.org/doctype/2.8.2/gwt-module.dtd">

<module rename-to="htmlplayer">
    <inherits name="games.pixscape.runtime.PixscapeRuntime"/>

    <entry-point class="games.pixscape.html.client.GwtLauncher"/>

    <set-configuration-property name="gdx.assetpath" value="assets"/>
    <set-property name="user.agent" value="safari"/>

    <extend-configuration-property name="artemis.reflect.include" value="com.badlogic.gdx.physics.box2d.Body"/>
    <extend-configuration-property name="artemis.reflect.include" value="com.badlogic.gdx.physics.box2d.Joint"/>
    <extend-configuration-property name="gdx.reflect.include" value="com.badlogic.gdx.physics.box2d.Body"/>
    <extend-configuration-property name="gdx.reflect.include" value="com.badlogic.gdx.physics.box2d.Joint"/>

    <source path="client"/>
</module>
